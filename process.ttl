# process.ttl — Модуль процессов, провенанса и администрирования (сквозной).
# Провенанс генерации (на базе PROV-O), экспертная приёмка, валидация, версия КРМ и цикл.
# Аннотации ru/en.

@prefix krm:  <http://example.org/krm#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

<http://example.org/krm/process> a owl:Ontology ;
    dct:title "Модуль процессов, провенанса и администрирования"@ru , "Process, provenance and administration module"@en ;
    rdfs:label "Процессы (process)"@ru , "Process (process)"@en ;
    owl:versionInfo "1.0.0" ;
    owl:imports <http://example.org/krm/assessment> ;
    rdfs:comment "Термины PROV-O (prov:Entity/Activity/Agent/...) используются как внешние ссылки без импорта полной онтологии PROV-O — для изолированной офлайн-загрузки."@ru ;
    dct:description "Провенанс генерации (PROV-O), экспертная приёмка порождённых артефактов, контур валидации, версия КРМ и цикл ассесмента. Сквозной модуль."@ru ,
        "Generation provenance (PROV-O), expert acceptance of generated artefacts, the validation contour, the KRM version and the assessment cycle. A cross-cutting module."@en .

############################ ПОРОЖДЁННЫЕ АРТЕФАКТЫ (общий тип) ############################

krm:GeneratedArtefact a owl:Class ; rdfs:subClassOf prov:Entity ;
    rdfs:label "Порождённый артефакт"@ru , "Generated artefact"@en ;
    rdfs:comment "Общий тип для обобщённого дескриптора, частного дескриптора, задания и варианта задания — всё, что создаётся НАМИ в процессе (в отличие от КРМ, которая дана извне и неизменна) и потому требует провенанса, валидации и экспертной приёмки."@ru ,
        "A common type for a general descriptor, a specific descriptor, a task and a task variant — everything WE create in the process (as opposed to the KRM, which is given from outside and immutable) and which therefore needs provenance, validation and expert acceptance."@en .

krm:GeneralDescriptor rdfs:subClassOf krm:GeneratedArtefact .
krm:Descriptor        rdfs:subClassOf krm:GeneratedArtefact .
krm:TaskTemplate      rdfs:subClassOf krm:GeneratedArtefact .
krm:TaskVariant       rdfs:subClassOf krm:GeneratedArtefact .

############################ ПРОВЕНАНС ГЕНЕРАЦИИ (PROV-O) ############################

krm:SystemAgent a owl:Class ; rdfs:subClassOf prov:SoftwareAgent ;
    rdfs:label "Системный агент"@ru , "System agent"@en ;
    rdfs:comment "Программный агент генерации заданий с помощью большой языковой модели."@ru ,
        "A software agent that generates tasks with a large language model."@en .

krm:GenerationActivity a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "Активность генерации"@ru , "Generation activity"@en ;
    rdfs:comment "Акт порождения варианта/шаблона: чем использован контекст, каким агентом, с каким результатом валидации."@ru ,
        "The act of generating a variant/template: what context was used, by which agent, with what validation outcome."@en .

krm:wasGeneratedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasGeneratedBy ;
    rdfs:domain krm:GeneratedArtefact ; rdfs:range krm:GenerationActivity ;
    rdfs:label "порождён активностью"@ru , "was generated by"@en .

krm:usedContext a owl:ObjectProperty ; rdfs:subPropertyOf prov:used ;
    rdfs:domain krm:GenerationActivity ;
    rdfs:label "использован контекст"@ru , "used context"@en ;
    rdfs:comment "Контекстные сущности, поданные в генерацию (КИУ, дескриптор, темы, источники, ИПД/ПЗ) — для воспроизводимости и провенанса."@ru ,
        "Context entities fed into generation (CIL, descriptor, topics, sources, tools/subjects) — for reproducibility and provenance."@en .

krm:byAgent a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain krm:GenerationActivity ; rdfs:range prov:Agent ;
    rdfs:label "выполнено агентом"@ru , "by agent"@en .

############################ ВАЛИДАЦИЯ И ЭКСПЕРТНАЯ ПРИЁМКА ############################

krm:Validation a owl:Class ; rdfs:subClassOf prov:Activity ;
    rdfs:label "Валидация"@ru , "Validation"@en ;
    rdfs:comment "Акт валидации артефакта (PROV-O prov:Activity): исполняемая среда/тесты (грейдер в песочнице), формальная проверка, LLM-судьи. Использует артефакт, несёт вердикт (пройдено/нет + детали прогона)."@ru ,
        "The act of validating an artefact (PROV-O prov:Activity): executable environment/tests (sandboxed grader), formal checks, LLM judges. Uses the artefact, carries the verdict (passed or not + run details)."@en .

krm:validationOf a owl:ObjectProperty , owl:FunctionalProperty ; rdfs:subPropertyOf prov:used ;
    rdfs:domain krm:Validation ; rdfs:range krm:GeneratedArtefact ;
    rdfs:label "валидация артефакта"@ru , "validation of"@en .

krm:passed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:boolean ;
    rdfs:label "пройдено"@ru , "passed"@en .

# --- Провенанс код-валидации (гарантия «задание сошлось»): кто/когда/чем/с каким результатом ---
krm:validatedBy a owl:ObjectProperty ; rdfs:subPropertyOf prov:wasAssociatedWith ;
    rdfs:domain krm:Validation ; rdfs:range prov:Agent ;
    rdfs:label "выполнено валидатором"@ru , "validated by"@en ;
    rdfs:comment "Кто провёл валидацию: системный агент (грейдер) или эксперт."@ru ,
        "Who performed the validation: a system agent (grader) or an expert."@en .

krm:validatedAt a owl:DatatypeProperty , owl:FunctionalProperty ; rdfs:subPropertyOf prov:endedAtTime ;
    rdfs:domain krm:Validation ; rdfs:range xsd:dateTime ;
    rdfs:label "время валидации"@ru , "validated at"@en .

krm:verdictCode a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:string ;
    rdfs:label "код вердикта"@ru , "verdict code"@en ;
    rdfs:comment "Машинный код исхода (valid / reference_incomplete / task_ill_posed / compile_error / env_violation)."@ru ,
        "Machine verdict code (valid / reference_incomplete / task_ill_posed / compile_error / env_violation)."@en .

krm:packageDigest a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:string ;
    rdfs:label "дайджест пакета"@ru , "package digest"@en ;
    rdfs:comment "sha256 ZIP-пакета задания (contentRef), фактически прогнанного грейдером — привязка «что проверено = что в банке»."@ru ,
        "sha256 of the task ZIP package (contentRef) actually run by the grader — binds «what was checked = what is in the bank»."@en .

krm:imageVersion a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:string ;
    rdfs:label "версия среды"@ru , "image version"@en ;
    rdfs:comment "Версия исполнительной среды грейдера (образ песочницы Judge0 + язык), в которой эталон прошёл тесты."@ru ,
        "Version of the grader execution environment (Judge0 sandbox image + language) in which the reference passed the tests."@en .

krm:testsTotal a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "тестов всего"@ru , "tests total"@en .

krm:testsPassed a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Validation ; rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "тестов пройдено"@ru , "tests passed"@en .

# --- «Валидировано» — ВЫВОДИМЫЙ флаг (артефакт с успешной валидацией), не хранимый ---
krm:hasValidation a owl:ObjectProperty ; owl:inverseOf krm:validationOf ;
    rdfs:label "имеет валидацию"@ru , "has validation"@en .

krm:PassedValidation a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        krm:Validation [ a owl:Restriction ; owl:onProperty krm:passed ; owl:hasValue true ] ) ] ;
    rdfs:label "Успешная валидация"@ru , "Passed validation"@en .

krm:ValidatedArtefact a owl:Class ;
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        krm:GeneratedArtefact [ a owl:Restriction ; owl:onProperty krm:hasValidation ; owl:someValuesFrom krm:PassedValidation ] ) ] ;
    rdfs:label "Валидированный артефакт"@ru , "Validated artefact"@en ;
    rdfs:comment "Артефакт, у которого есть успешная валидация — ВЫВОДИТСЯ ризонером (флаг «валидировано» не хранится)."@ru ,
        "An artefact that has a passed validation — INFERRED by the reasoner (the «validated» flag is not stored)."@en .

krm:ExpertAcceptance a owl:Class ;
    rdfs:label "Экспертная приёмка"@ru , "Expert acceptance"@en ;
    rdfs:comment "Формальное подтверждение эксперта, что порождённый дескриптор/шаблон/вариант корректен. Обязательный шаг допуска в банк; фиксируется с экспертом и временем."@ru ,
        "An expert's formal confirmation that a generated descriptor/template/variant is correct. A mandatory admission step; recorded with the expert and a timestamp."@en .

krm:acceptanceOf a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain krm:ExpertAcceptance ; rdfs:range krm:GeneratedArtefact ;
    rdfs:label "приёмка артефакта"@ru , "acceptance of"@en .

krm:acceptedBy a owl:ObjectProperty , owl:FunctionalProperty ;
    rdfs:domain krm:ExpertAcceptance ; rdfs:range krm:Expert ;
    rdfs:label "принял эксперт"@ru , "accepted by"@en .

krm:acceptedAt a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:ExpertAcceptance ; rdfs:range xsd:dateTime ;
    rdfs:label "время приёмки"@ru , "accepted at"@en .

############################ ВЕРСИЯ КРМ И ЦИКЛ ############################

krm:KRMVersion a owl:Class ;
    rdfs:label "Версия КРМ"@ru , "KRM version"@en ;
    rdfs:comment "Версия компетентностно-ролевой модели, в рамках которой сущности неизменяемы."@ru ,
        "A version of the competency–role model within which entities are immutable."@en .

krm:Cycle a owl:Class ;
    rdfs:label "Цикл ассесмента"@ru , "Assessment cycle"@en ;
    rdfs:comment "Годовой цикл проведения ассесмента (например, апробация 2026)."@ru ,
        "An annual assessment cycle (e.g. the 2026 pilot)."@en .

krm:inCycle a owl:ObjectProperty ;
    rdfs:range krm:Cycle ;
    rdfs:label "в цикле"@ru , "in cycle"@en .

krm:underKRMVersion a owl:ObjectProperty ;
    rdfs:range krm:KRMVersion ;
    rdfs:label "по версии КРМ"@ru , "under KRM version"@en .

krm:year a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:domain krm:Cycle ; rdfs:range xsd:integer ;
    rdfs:label "год"@ru , "year"@en .

############################ КЛЮЧИ ############################

krm:KRMVersion owl:hasKey ( krm:code ) .
krm:Cycle owl:hasKey ( krm:code ) .
